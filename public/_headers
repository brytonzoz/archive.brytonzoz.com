# Content-hashed build output and media never change at a given URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

# The offline worker must always be checked for updates.
/sw.js
  Cache-Control: no-cache

# Apple Pay domain verification (Stripe's file), served as plain bytes.
/.well-known/apple-developer-merchantid-domain-association
  Content-Type: text/plain
  Cache-Control: public, max-age=3600

# /shipped is a private X link, not for search. Header backup for the page's noindex
# meta. Do not Disallow it in robots.txt — crawlers (and X's card bot) need to fetch it.
/shipped
  X-Robots-Tag: noindex, nofollow, noarchive

/shipped/
  X-Robots-Tag: noindex, nofollow, noarchive

/shipped/*
  X-Robots-Tag: noindex, nofollow, noarchive
